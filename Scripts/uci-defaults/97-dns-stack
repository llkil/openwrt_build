#!/bin/sh
# SPDX-License-Identifier: MIT
# 首次开机：smartdns 上游 + 三级看门狗 + PassWall 默认值 + 订阅自动更新。
# 与 20-smartdns-adblock 分工：那边负责规则与 smartdns 基础开关，这里只管上游与守护。
# 任何一步失败都不阻塞开机（返回 0）。

log() { logger -t dns-stack "$*"; }

# ── 1. smartdns 上游 ───────────────────────────────────────────
# 阿里 DoH/DoT 权重 5 当主力；腾讯只留 DoT（其 DoH 端点会被 429 限流）；
# 再加 DNSPod 明文 UDP 兜底。已有同名 section 时不覆盖用户改动。
if [ -x /usr/sbin/smartdns ]; then
	add_srv() {
		# $1 section  $2 name  $3 type  $4 ip  [$5 port] [$6 addition_arg] [$7 host_name]
		uci -q show "smartdns.$1" >/dev/null 2>&1 && return 0
		uci -q set "smartdns.$1=server"
		uci -q set "smartdns.$1.name=$2"
		uci -q set "smartdns.$1.type=$3"
		uci -q set "smartdns.$1.ip=$4"
		uci -q set "smartdns.$1.enabled=1"
		[ -n "${5:-}" ] && uci -q set "smartdns.$1.port=$5"
		[ -n "${6:-}" ] && uci -q set "smartdns.$1.addition_arg=$6"
		[ -n "${7:-}" ] && uci -q set "smartdns.$1.host_name=$7"
	}
	add_srv ali_doh ali-doh https "https://223.5.5.5/dns-query" "" "-weight 5" "dns.alidns.com"
	add_srv ali_dot ali-dot tls "223.5.5.5" "853" "-weight 5" ""
	add_srv tencent_dot tencent-dot tls "dot.pub" "853" "" ""
	add_srv dnspod_udp dnspod-udp udp "119.29.29.29" "" "" ""
	uci -q commit smartdns
fi

# ── 2. smartdns 三级看门狗 ─────────────────────────────────────
# procd 只管进程死亡；这里补：假死（进程在、端口死）、init 竞态、procd 实例丢失。
if [ -x /usr/sbin/smartdns ] && [ ! -x /usr/bin/smartdns-watchdog.sh ]; then
	cat > /usr/bin/smartdns-watchdog.sh <<'WATCHDOG'
#!/bin/sh
# smartdns 三级看门狗：端口检查 → init 重启重试 → 绕过 init 直启
LOG=/tmp/smartdns-watchdog.log
if [ -s "$LOG" ] && [ "$(wc -l < "$LOG")" -gt 100 ]; then
	tail -n 50 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"
fi
say() { echo "$(date '+%F %T') $*" >> "$LOG"; }
up() { netstat -lnu 2>/dev/null | grep -q ':6053 '; }
up_tcp() { netstat -lnt 2>/dev/null | grep -q ':6053 '; }

up && up_tcp && exit 0
say "L1 fail: udp=$(up && echo up || echo down) tcp=$(up_tcp && echo up || echo down)"

i=0
while [ $i -lt 3 ]; do
	for pid in $(pgrep -f '/usr/sbin/smartdns' 2>/dev/null); do
		kill -9 "$pid" 2>/dev/null
	done
	sleep 1
	/etc/init.d/smartdns start >/dev/null 2>&1
	sleep 3
	if up && up_tcp; then
		say "L2 recovered (attempt $((i+1)))"
		exit 0
	fi
	i=$((i+1))
done

if [ -s /var/etc/smartdns/smartdns.conf ]; then
	/usr/sbin/smartdns -f -c /var/etc/smartdns/smartdns.conf >/dev/null 2>&1 &
	sleep 3
	if up && up_tcp; then
		say "L3 recovered via direct spawn"
		exit 0
	fi
fi

say "L3 fail: smartdns unreachable, manual check required"
exit 1
WATCHDOG
	chmod +x /usr/bin/smartdns-watchdog.sh
fi

# ── 3. PassWall 默认值 ────────────────────────────────────────
# 分流依赖 DNS 劫持给目标 IP 打 nftset 标记，因此 dns_redirect 必须为 1。
if [ -f /etc/config/passwall ]; then
	uci -q set passwall.@global[0].loglevel='warn'
	uci -q set passwall.@global[0].dns_shunt='chinadns-ng'
	uci -q set passwall.@global[0].dns_redirect='1'
	uci -q set passwall.@global[0].dnsmasq_dns_redirect='1'
	uci -q commit passwall
fi

# ── 4. 定时任务 ───────────────────────────────────────────────
CRON=/etc/crontabs/root
touch "$CRON"
grep -q 'smartdns-watchdog.sh' "$CRON" ||
	echo '*/2 * * * * /usr/bin/smartdns-watchdog.sh' >> "$CRON"
grep -q 'subscribe.lua' "$CRON" ||
	echo '17 5 * * 3 for s in $(uci show passwall 2>/dev/null | grep "=subscribe_list" | cut -d. -f2 | cut -d= -f1); do lua /usr/share/passwall/subscribe.lua start $s > /dev/null 2>&1; done' >> "$CRON"
/etc/init.d/cron enable >/dev/null 2>&1
/etc/init.d/cron restart >/dev/null 2>&1

log "dns-stack defaults applied"
exit 0
