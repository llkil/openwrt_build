#!/bin/sh
# Project overlay: pre-configure bundled plugins on first boot.
# build.py copies every file here into files/etc/uci-defaults (run once, then removed).

# OAF / OpenAppFilter: the appfilter init script ships "option enable 1" in
# /etc/config/fwx, so only autostart needs to be registered.
[ -x /etc/init.d/appfilter ] && /etc/init.d/appfilter enable >/dev/null 2>&1

# UPnP: keep miniupnpd enabled with the default br-lan / wan interface pair.
if [ -x /etc/init.d/miniupnpd ]; then
	/etc/init.d/miniupnpd enable >/dev/null 2>&1
	uci -q set upnpd.config.enabled='1'
	uci -q set upnpd.config.internal_iface='br-lan'
	uci -q set upnpd.config.external_iface='wan'
	uci -q commit upnpd
fi

# ttyd web terminal.
if [ -x /etc/init.d/ttyd ]; then
	/etc/init.d/ttyd enable >/dev/null 2>&1
	uci -q set ttyd.@ttyd[0].enabled='1'
	uci -q commit ttyd
fi

# fstab / automount, used by the disk manager page.
[ -x /etc/init.d/fstab ] && /etc/init.d/fstab enable >/dev/null 2>&1

# CPU frequency scaling: the MTK defconfig pins governor=performance (max clock),
# so any live-frequency display reads a constant 1800MHz. schedutil scales
# 800-1800MHz with load and still reaches max under saturation.
if [ -x /etc/init.d/cpufreq ] && grep -qw schedutil /sys/devices/system/cpu/cpufreq/policy0/scaling_available_governors 2>/dev/null; then
	uci -q set cpufreq.cpufreq.governor0='schedutil'
	uci -q commit cpufreq
	/etc/init.d/cpufreq enable >/dev/null 2>&1
fi

# Per-client traffic monitor: the package ships the service but nothing
# enables it, so register autostart and start it on first boot.
if [ -x /etc/init.d/flowmon ]; then
	/etc/init.d/flowmon enable >/dev/null 2>&1
	/etc/init.d/flowmon start >/dev/null 2>&1
fi

# LuCI: Chinese UI (theme and timezone come from 95-project-defaults).
uci -q set luci.main.lang='zh-cn'
uci -q commit luci

exit 0
