#!/bin/sh
# flowmon-panel — LuCI RPC 入口
#   live             当前实时速率 JSON
#   series           波形环形缓冲
#   history [日期]   聚合 JSON（无参=全部保留期，YYYY-MM-DD=仅该日）
#   dates            可用日期列表 + 当前保留设置
#   setretention N   修改保留天数并重启采集器（N ∈ 1/2/3/7/14/30/60/90）

RUN=/tmp/flowmon
DATA=/overlay/flowmon

retention_days() {
    R=$(uci -q get flowmon.settings.retention_days 2>/dev/null)
    case "$R" in
        1|2|3|7|14|30|60|90) echo "$R" ;;
        *) echo 2 ;;
    esac
}

case "$1" in
live)
    if [ -f "$RUN/live.json" ]; then
        cat "$RUN/live.json"
    else
        echo '{"error":"采集器未运行"}'
    fi
    ;;

series)
    if [ -s "$RUN/spark.txt" ]; then
        awk 'BEGIN { printf "{\"points\":[" }
        { printf "%s{\"t\":%s,\"rx\":%s,\"tx\":%s}", (NR > 1 ? "," : ""), $1, $2, $3 }
        END { printf "]}\n" }' "$RUN/spark.txt"
    else
        echo '{"points":[]}'
    fi
    ;;

history)
    WANT="$2"
    TMP=/tmp/flowmon/hist.tmp
    mkdir -p "$RUN"
    : > "$TMP"
    for f in "$DATA"/*.csv; do
        [ -f "$f" ] || continue
        d=${f##*/}
        d=${d%.csv}
        [ -n "$WANT" ] && [ "$d" != "$WANT" ] && continue
        awk -F, -v day="$d" '
        NF >= 4 && $2 != "" {
            printf "c_%s %d %d\n", $2, $3, $4
            printf "h_%s %s %d %d\n", day, substr($1, 1, 2), $3, $4
        }' "$f" >> "$TMP"
    done
    awk '
    $1 ~ /^c_/ { CR[$1] += $2; CT[$1] += $3; if (!($1 in SEENC)) { SEENC[$1] = 1; NI++; ID[NI] = $1 }; next }
    $1 ~ /^h_/ { HK = $1 " " $2; HR[HK, 1] += $3; HR[HK, 2] += $4; if (!(HK in SEEN)) { SEEN[HK] = 1; NH++; HO[NH] = HK }; next }
    END {
        printf "{\"clients\":["
        for (i = 1; i <= NI; i++) {
            best = -1
            for (j = 1; j <= NI; j++) {
                if (ID[j] == "") continue
                v = CR[ID[j]] + CT[ID[j]]
                if (v > best) { best = v; pick = j }
            }
            ip = ID[pick]; ID[pick] = ""
            printf "%s{\"ip\":\"%s\",\"rx\":%.1f,\"tx\":%.1f}", (i > 1 ? "," : ""), substr(ip, 3), CR[ip], CT[ip]
        }
        printf "],\"hours\":["
        for (i = 1; i <= NH; i++) {
            for (j = 1; j <= NH; j++) {
                if (HO[j] == "") continue
                if (min == "" || HO[j] < min) { min = HO[j]; pick = j }
            }
            k = HO[pick]; HO[pick] = ""; min = ""
            printf "%s{\"h\":\"%s %s\",\"rx\":%.1f,\"tx\":%.1f}", (i > 1 ? "," : ""), substr(k, 3, 10), substr(k, 14), HR[k, 1], HR[k, 2]
        }
        printf "]}"
    }
    ' "$TMP"
    rm -f "$TMP"
    echo
    ;;

dates)
    R=$(retention_days)
    USED=$(du -sk "$DATA" 2>/dev/null | awk '{print $1}')
    printf '{"retention":%s,"used_kb":%s,"days":[' "$R" "${USED:-0}"
    FIRST=1
    for f in "$DATA"/*.csv; do
        [ -f "$f" ] || continue
        d=${f##*/}
        d=${d%.csv}
        [ $FIRST -eq 1 ] || printf ','
        printf '"%s"' "$d"
        FIRST=0
    done
    printf ']}\n'
    ;;

setretention)
    N="$2"
    case "$N" in
        1|2|3|7|14|30|60|90) ;;
        *) echo '{"error":"unsupported retention"}'; exit 1 ;;
    esac
    uci -q set flowmon.settings.retention_days="$N"
    uci -q commit flowmon
    # 重启采集器让新保留期生效（启动时会立即清理一次过期/超限文件）
    ( /etc/init.d/flowmon restart >/dev/null 2>&1 & )
    sleep 2
    echo "{\"retention\":$N}"
    ;;

*)
    echo "usage: flowmon-panel live|series|history [date]|dates|setretention <days>"
    exit 1
    ;;
esac
