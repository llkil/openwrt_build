#!/bin/sh /etc/rc.common
# flowmon - per-client traffic accounting driven by nft hook counters.
# START=99 starts it after network/firewall so the WAN interface resolves.

START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh /usr/bin/flowmon-loop
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}
